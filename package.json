{
  "name": "gemkid",
  "private": true,
  "version": "0.1.0",
  "description": "GemKid: a Grades 1–8 learning portal demo — math, logic, coding, algorithms, English, French and Bengali. Play. Learn. Grow.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "node scripts/validate-content.ts",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run validate && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.2.0",
    "@fontsource/nunito": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0"
  }
}
